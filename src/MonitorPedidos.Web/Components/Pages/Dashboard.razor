@page "/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AlertBroadcaster Broadcaster
@inject IIncidentService IncidentService
@inject IBrandMonitorService BrandMonitorService
@inject AuthenticationStateProvider AuthStateProvider
@inject LastCheckStore LastCheckStore
@inject IServiceScopeFactory ScopeFactory
@inject IRuleRepository RuleRepository
@inject ILogger<Dashboard> _logger
@inject IConfiguration _config
@inject IJSRuntime JS


<PageTitle>Dashboard — Monitor Pedidos eCommerce</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-2">
    <div>
        <h2 class="mb-0 fw-bold">Dashboard — Monitor Pedidos eCommerce</h2>
        <p class="text-muted small mb-0">
            @if (_cardsLastUpdate is not null)
            {
                <span>Actualizado hace: <strong>@FormatElapsed(_cardsLastUpdate.Value)</strong> · Próxima actualización en: <strong>@FormatCountdown(_cardsCountdown)</strong></span>
            }
            else
            {
                <span>Cargando...</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <button class="btn btn-outline-secondary btn-sm" data-testid="btn-check-now" @onclick="ManualRefreshAsync" disabled="@_refreshing">
            @if (_refreshing) { <span class="spinner-border spinner-border-sm me-1"></span> }
            &#9889; Chequear ahora
        </button>
        <span class="badge fs-6 px-3 py-2 bg-@_overallColor" data-testid="overall-status" data-color="@_overallColor">&#9679; @_overallText</span>
    </div>
</div>

<div class="row g-3 mb-4">
    @foreach (var d in _domains)
    {
        <div class="col-6 col-md-3" data-testid="domain-card-@d.Code">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-3 px-2">
                    <div class="text-muted mb-1" style="font-size:0.75rem;font-weight:600;letter-spacing:.05em">@d.Code</div>
                    <div class="fw-semibold mb-2" style="font-size:0.85rem">@d.Label</div>
                    @if (d.Color == "danger")
                    {
                        <div class="d-flex justify-content-center mb-2">
                            <span class="rounded-circle bg-danger shadow-sm" style="width:2.5rem;height:2.5rem;display:inline-block"></span>
                        </div>
                    }
                    else if (d.Color == "warning")
                    {
                        <div class="d-flex justify-content-center mb-2">
                            <span class="rounded-circle bg-warning shadow-sm" style="width:2.5rem;height:2.5rem;display:inline-block"></span>
                        </div>
                    }
                    else if (d.Color == "secondary")
                    {
                        <div class="d-flex justify-content-center mb-2">
                            <span class="rounded-circle bg-secondary shadow-sm" style="width:2.5rem;height:2.5rem;display:inline-block"></span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-center mb-2">
                            <span class="rounded bg-success shadow-sm d-inline-flex align-items-center justify-content-center text-white" style="width:2.5rem;height:2.5rem;font-size:1.4rem;font-weight:700">&#10004;</span>
                        </div>
                    }
                    @if (d.ApiDetails is not null)
                    {
                        <div class="mt-1">
                            @foreach (var api in d.ApiDetails)
                            {
                                <div class="px-1" style="font-size:0.7rem">
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="text-muted">@api.Name</span>
                                        <span class="@ApiStatusClass(api.BadgeColor) fw-semibold ms-1">@ApiStatusIcon(api.BadgeColor) @api.StatusLabel</span>
                                    </div>
                                    @if (api.Detail is not null)
                                    {
                                        <div class="text-muted text-end" style="font-size:0.65rem;margin-top:-1px">(@api.Detail)</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (d.Channels is not null)
                    {
                        <div class="mt-1">
                            @foreach (var ch in d.Channels)
                            {
                                <div class="d-flex justify-content-between align-items-center small px-1 @(ch.IsOk ? "" : "text-danger")" style="font-size:0.7rem">
                                    <span>@ch.Name</span>
                                    <span>@ch.Count pedidos @(ch.IsOk ? "✅" : "❌")</span>
                                </div>
                            }
                        </div>
                    }
                    @if (_cardsLastUpdate is not null)
                    {
                        <div class="text-muted" style="font-size:0.65rem">@_cardsLastUpdate.Value.ToLocalTime().ToString("HH:mm:ss")</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (_incidentsFallback)
{
    <div class="alert alert-warning py-2 mb-4">
        <strong>BD no disponible</strong> — no se pueden cargar incidentes. Estados derivados de última verificación.
    </div>
}
else if (_openIncidents.Any())
{
    <h5 class="mb-2">Alertas Activas <span class="badge bg-danger ms-1">@_openIncidents.Count</span></h5>
    <div class="table-responsive mb-4">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Módulo</th>
                    <th>Sev.</th>
                    <th>¿Qué ocurrió?</th>
                    <th class="text-nowrap">Detectado</th>
                    <th>Causa</th>
                    <th>Siguiente paso</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inc in _openIncidents)
                {
                    <tr>
                        <td>
                            <span class="badge bg-secondary">M@((int)inc.Module)</span>
                        </td>
                        <td>
                            <span class="badge bg-@SeverityColor(inc.Severity)">@inc.Severity.ToString().ToUpper()</span>
                        </td>
                        <td class="small">@(inc.Alert?.QuePaso ?? "-")</td>
                        <td class="small text-nowrap">@inc.OpenedAt.ToLocalTime().ToString("d/M/yyyy, h:mm tt")</td>
                        <td class="small">
                            <span class="text-warning fw-semibold">@inc.Cause.ToString().ToLower()</span>
                        </td>
                        <td class="small">@(inc.Alert?.AccionSugerida ?? "-")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-success"
                                    style="min-width:5rem"
                                    @onclick="() => ResolveAsync(inc.Id)"
                                    disabled="@_resolving.Contains(inc.Id)">
                                &#10003; Resolver
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-success py-2 mb-4">Sin incidentes activos actualmente.</div>
}

<p class="text-muted small mb-1">
    @if (_brandLastUpdate is not null)
    {
        <span>Últ. consulta a Salesforce: <strong>@_brandLastUpdate.Value.ToLocalTime().ToString("hh:mm tt")</strong> &nbsp;·&nbsp; Próxima consulta automática en: <strong>@FormatCountdown(_brandCountdown)</strong></span>
    }
    else if (_brandDbUnavailable)
    {
        <span><span class="text-warning">Sin historial disponible</span> &nbsp;·&nbsp; Próxima consulta automática en: <strong>@FormatCountdown(_brandCountdown)</strong></span>
    }
    else if (_brandLoading)
    {
        <span>Consultando Salesforce...</span>
    }
    else
    {
        <span>Sin datos aún &nbsp;·&nbsp; Próxima consulta automática en: <strong>@FormatCountdown(_brandCountdown)</strong></span>
    }
</p>

<div class="d-flex align-items-center mb-2" data-testid="brand-monitor-header">
    <h5 class="mb-0">Pedidos por descargar</h5>
    <span class="text-muted small ms-2">— Pedidos pendientes de descarga en Salesforce por marca</span>
    <button class="btn btn-outline-secondary btn-sm ms-auto" data-testid="btn-brand-refresh" @onclick="() => RefreshBrandAsync(true)" disabled="@(_brandLoading || _brandRefreshing)">
        @if (_brandRefreshing) { <span class="spinner-border spinner-border-sm me-1"></span><span>Consultando Salesforce...</span> }
        else { <span>&#8635; Consultar Salesforce</span> }
    </button>
</div>

@if (_brandStale)
{
    <div class="alert alert-warning py-2 mb-2">
        ⚠ <strong>Datos desactualizados</strong> · BD no disponible — mostrando última información conocida
    </div>
}

@if (_brandLoading)
{
    <p data-testid="brand-loading" class="text-muted small">Cargando datos de marcas...</p>
}
else if (!_brandSnapshots.Any())
{
    @if (_brandLiveManual && _brandLiveCounts is not null)
    {
        <div class="alert alert-warning py-2 mb-2">
            ⚠ <strong>Tiempo real</strong> · BD no disponible — datos consultados ahora en Salesforce, sin historial
        </div>
        <div class="table-responsive" data-testid="brand-monitor-table">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Marca</th>
                        <th class="text-center">Pendientes actuales</th>
                        <th class="text-center">Anterior</th>
                        <th class="text-center">Cambio</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kv in _brandLiveCounts)
                    {
                        <tr>
                            <td><strong>@kv.Key</strong></td>
                            <td class="text-center fw-semibold">@kv.Value</td>
                            <td class="text-center text-muted">—</td>
                            <td class="text-center text-muted">—</td>
                            <td class="text-center"><span class="badge bg-secondary">⚠ Sin historial</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_brandDbUnavailable)
    {
        var liveCounts = GetBrandCountsFromLastCheckStore();
        @if (liveCounts is not null)
        {
            <div class="alert alert-warning py-2 mb-2">
                ⚠ <strong>Datos en tiempo real</strong> · BD no disponible — sin comparación histórica
            </div>
            <div class="table-responsive" data-testid="brand-monitor-table">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Marca</th>
                            <th class="text-center">Pendientes actuales</th>
                            <th class="text-center">Anterior</th>
                            <th class="text-center">Cambio</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kv in liveCounts)
                        {
                            <tr>
                                <td><strong>@kv.Key</strong></td>
                                <td class="text-center fw-semibold">@kv.Value</td>
                                <td class="text-center text-muted">—</td>
                                <td class="text-center text-muted">—</td>
                                <td class="text-center"><span class="badge bg-secondary">⚠ Sin historial</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning py-2 mb-2">
                ⚠ <strong>BD no disponible</strong> · Esperando primer ciclo del checker — datos en camino
            </div>
            <div class="table-responsive" data-testid="brand-monitor-table">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Marca</th>
                            <th class="text-center">Pendientes actuales</th>
                            <th class="text-center">Anterior</th>
                            <th class="text-center">Cambio</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var site in BrandSnapshot.Sites)
                        {
                            <tr>
                                <td><strong>@site</strong></td>
                                <td class="text-center text-muted">—</td>
                                <td class="text-center text-muted">—</td>
                                <td class="text-center text-muted">—</td>
                                <td class="text-center"><span class="badge bg-secondary">Sin datos</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        <div class="alert alert-secondary py-2 mb-2">Sin datos aún — esperando primer ciclo del scheduler</div>
        <div class="table-responsive" data-testid="brand-monitor-table">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Marca</th>
                        <th class="text-center">Pendientes actuales</th>
                        <th class="text-center">Anterior</th>
                        <th class="text-center">Cambio</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var site in BrandSnapshot.Sites)
                    {
                        <tr>
                            <td><strong>@site</strong></td>
                            <td class="text-center text-muted">—</td>
                            <td class="text-center text-muted">—</td>
                            <td class="text-center text-muted">—</td>
                            <td class="text-center"><span class="badge bg-secondary">Sin datos</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <div class="table-responsive" data-testid="brand-monitor-table">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Marca</th>
                    <th class="text-center">Pendientes ahora</th>
                    <th class="text-center">Hace 10 min</th>
                    <th class="text-center">Variación</th>
                    <th class="text-center">Estado</th>
                    <th>Hora consulta</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _brandSnapshots)
                {
                    var hasHistory = s.PendingCountPrevious.HasValue;
                    var drop       = hasHistory ? s.PendingCountPrevious!.Value - s.PendingCountCurrent : (int?)null;
                    var bc = !hasHistory ? "secondary" : drop switch { > 0 => "success", < 0 => "danger", _ => "warning" };
                    var be = !hasHistory ? "Sin datos"  : drop switch { > 0 => "🟢 OK",   < 0 => "🔴 Crítico", _ => "🟡 Moderado" };
                    <tr>
                        <td><strong>@s.Site</strong></td>
                        <td class="text-center fw-semibold">@(s.PendingCountCurrent < 0 ? "N/D" : s.PendingCountCurrent.ToString())</td>
                        <td class="text-center text-muted">@(hasHistory ? s.PendingCountPrevious!.Value.ToString() : "—")</td>
                        <td class="text-center">
                            @if (!hasHistory) { <span class="text-muted">—</span> }
                            else if (drop > 0) { <span class="text-success fw-semibold">▼ @drop</span> }
                            else if (drop < 0) { <span class="text-danger fw-semibold">▲ @(-drop)</span> }
                            else               { <span class="text-muted">—</span> }
                        </td>
                        <td class="text-center"><span class="badge bg-@bc">@be</span></td>
                        <td class="text-muted small">@DateTime.SpecifyKind(s.CheckedAt, DateTimeKind.Utc).ToLocalTime().ToString("HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const int CardsRefreshIntervalSeconds = 30;

    // Lee dinámicamente desde la tabla `rules` en Supabase — fallback a config
    private double BrandCheckerIntervalMinutes
    {
        get
        {
            // Intentar leer de la BD (cacheado en campo privado)
            if (_brandPollIntervalMinutes > 0) return _brandPollIntervalMinutes;

            // Fallback a appsettings
            return _config.GetValue("Monitoring:BrandMonitorPollIntervalMinutes", 3.0);
        }
    }

    private double _brandPollIntervalMinutes = 0;

    private DateTimeOffset? _cardsLastUpdate  = null;
    private DateTimeOffset? _brandLastUpdate  = null;
    // Último CheckedAt conocido del checker — detecta cuando hay datos nuevos
    private DateTimeOffset  _brandLastCheckedAt = DateTimeOffset.MinValue;
    private int _cardsCountdown = CardsRefreshIntervalSeconds;
    // Countdown calculado desde LastCheckStore — siempre sincronizado con el checker real
    private int _brandCountdown = 0;
    private List<DomainCard>             _domains           = BuildDefaultDomains();
    private List<Incident>               _openIncidents     = [];
    private IReadOnlyList<BrandSnapshot> _brandSnapshots  = [];
    private bool                              _brandLoading       = true;
    private bool                              _brandRefreshing    = false;
    private bool                              _brandStale         = false;
    private bool                              _brandDbUnavailable = false;
    private bool                              _brandLiveManual    = false;
    private IReadOnlyDictionary<string, int>? _brandLiveCounts    = null;
    private bool                         _refreshing        = false;
    private HashSet<Guid>                _resolving         = [];
    private string                       _userRole          = "Operador";

    private string _overallColor     = "success";
    private string _overallText      = "OPERATIVO";
    private bool   _incidentsFallback = false;

    private Func<AlertMessage, Task>? _alertHandler;
    private Func<Guid, Task>?         _closeHandler;
    private CancellationTokenSource   _cts = new();

    protected override async Task OnInitializedAsync()
    {
        //var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        //_userRole = auth.User.IsInRole("Técnico") ? "Técnico" : "Operador";
        _userRole = "Técnico";
        // Cargar pollIntervalMinutes dinámicamente desde BD
        await LoadBrandPollIntervalAsync();

        // Iniciar countdown desde el intervalo correcto (antes de que el checker haya corrido)
        _brandCountdown = (int)(BrandCheckerIntervalMinutes * 60);

        await RefreshAllAsync();

        _alertHandler = async _ =>
        {
            await RefreshIncidentsAsync();
            await InvokeAsync(StateHasChanged);
           // await JS.InvokeVoidAsync("startTitleAlert");
        };
        //_closeHandler = async _ =>
        //{
          //  await RefreshIncidentsAsync();
            //await InvokeAsync(StateHasChanged);
            // Detener parpadeo si ya no quedan incidentes críticos
            //if (!_openIncidents.Any(i => i.Severity == Severity.Critical))
               // await JS.InvokeVoidAsync("stopTitleAlert");
        //};
        _closeHandler = async _ =>
{
    await RefreshIncidentsAsync();
    await InvokeAsync(StateHasChanged);
};

        Broadcaster.OnAlert          += _alertHandler;
        Broadcaster.OnIncidentClosed += _closeHandler;

        _ = StartCardsTimerAsync(_cts.Token);
    }

    private async Task LoadBrandPollIntervalAsync()
    {
        try
        {
            var rules = await RuleRepository.GetActiveByModuleAsync(ModuleId.BrandMonitor);
            if (rules.Count == 0) return;

            using var doc = JsonDocument.Parse(rules[0].ConditionJson);
            if (doc.RootElement.TryGetProperty("pollIntervalMinutes", out var prop)
                && prop.TryGetDouble(out var minutes)
                && minutes >= 1)
            {
                _brandPollIntervalMinutes = minutes;
                _logger.LogDebug("[Dashboard] Cargado pollIntervalMinutes={Min} min desde BD", minutes);
            }
        }
        catch (Exception ex)
        {
            _logger.LogWarning("[Dashboard] Error cargando pollIntervalMinutes: {Msg}", ex.Message);
            // Fallback a appsettings automático vía propiedad BrandCheckerIntervalMinutes
        }
    }

    private async Task StartCardsTimerAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(1000, ct);

                // — Cards (incidentes/módulos): countdown propio cada 30s —
                _cardsCountdown--;
                if (_cardsCountdown <= 0)
                {
                    _cardsCountdown = CardsRefreshIntervalSeconds;
                    await RefreshIncidentsAsync();
                }

                // — Brand Monitor: countdown decrece 1s por tick; se reinicia al detectar nueva consulta —
                var checkerIntervalSec = (int)(BrandCheckerIntervalMinutes * 60);

                if (LastCheckStore.Results.TryGetValue(ModuleId.BrandMonitor, out var brandResult)
                    && brandResult.CheckedAt > _brandLastCheckedAt)
                {
                    // El checker (automático o el botón manual) produjo datos nuevos:
                    // reiniciar el countdown al intervalo completo y recargar la BD.
                    _brandLastCheckedAt = brandResult.CheckedAt;
                    _brandCountdown     = checkerIntervalSec;
                    await RefreshBrandAsync();
                }
                else
                {
                    // Decremento simple cada segundo. Al llegar a 0 reinicia al intervalo
                    // (nunca se queda pegado en 0 aunque el checker de fondo se retrase).
                    _brandCountdown = _brandCountdown > 0
                        ? _brandCountdown - 1
                        : checkerIntervalSec;
                }

                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) { break; }
            catch { }
        }
    }

    private async Task ManualRefreshAsync()
    {
        _refreshing = true;
        _cardsCountdown = CardsRefreshIntervalSeconds;
        StateHasChanged();

        // 1. Ejecutar todos los checkers AHORA (M2, M3, M4, M11)
        await RunCheckersNowAsync();

        // Pequeña espera para que los writes en BD completen antes de leer
        await Task.Delay(300);

        // 2. Leer resultados actualizados en la UI
        await RefreshAllAsync();

        _refreshing = false;
        StateHasChanged();
    }

    // Corre M2/M3/M4 inmediatamente con timeout corto (5s) para respuesta rápida.
    // M11 (Jobs) usa timeout propio y no bloquea — su resultado llega cuando pueda.
    private async Task RunCheckersNowAsync()
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var checkers      = scope.ServiceProvider.GetRequiredService<IEnumerable<ICheckExecutor>>();
            var monitoringSvc = scope.ServiceProvider.GetRequiredService<IMonitoringService>();

            const int fastTimeoutMs = 5_000;   // 5s para M2/M3/M4 — deben ser rápidos
            const int slowTimeoutMs = 10_000;  // 10s para M11 — puede estar inaccesible

            var checkerList   = checkers.ToList();
            var fastCheckers  = checkerList.Where(c =>
                c.Module != ModuleId.BrandMonitor && c.Module != ModuleId.JobsMonitor).ToList();

            var fastTasks = fastCheckers.Select(async checker =>
            {
                using var cts = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
                cts.CancelAfter(fastTimeoutMs);
                try { await monitoringSvc.RunCheckAsync(checker, cts.Token); }
                catch { }
            });

            // Espera solo los checkers rápidos (M2/M3/M4) — resultado en ~5s
            await Task.WhenAll(fastTasks);

            // M11 corre sin bloquear (fire-and-forget con timeout propio)
            var m11 = checkerList.FirstOrDefault(c => c.Module == ModuleId.JobsMonitor);
            if (m11 is not null)
            {
                _ = Task.Run(async () =>
                {
                    using var cts = new CancellationTokenSource(slowTimeoutMs);
                    try { await monitoringSvc.RunCheckAsync(m11, cts.Token); }
                    catch { }
                });
            }
        }
        catch (Exception ex)
        {
            _logger.LogWarning("RunCheckersNowAsync: {Msg}", ex.Message);
        }
    }

    private async Task RefreshAllAsync()
    {
        await Task.WhenAll(RefreshIncidentsAsync(), RefreshBrandAsync());
    }

    private async Task RefreshIncidentsAsync()
    {
        try
        {
            var filter = new IncidentSearchFilter { Take = 100 };
            var paged  = await IncidentService.SearchHistoryAsync(filter);
            _openIncidents = paged.Items
                .Where(i => i.ClosedAt is null)
                .OrderByDescending(i => i.OpenedAt)
                .ToList();
            _cardsLastUpdate   = DateTimeOffset.UtcNow;
            _incidentsFallback = false;

            _domains = BuildDefaultDomains();
            foreach (var inc in _openIncidents)
                UpdateDomainCard(inc);

            foreach (var d in _domains.Where(d => d.Channels is null))
                ApplyLastCheckResult(d);

            UpdateOverallStatus();
        }
        catch (Exception ex)
        {
            _logger.LogWarning("Dashboard RefreshIncidentsAsync degradado: {Msg}", ex.Message);
            _incidentsFallback = true;
            _domains           = BuildDomainsFromLastCheckStore();
            UpdateOverallStatus();
        }
    }

    private List<DomainCard> BuildDomainsFromLastCheckStore()
    {
        var domains = BuildDefaultDomains();
        var map = new Dictionary<string, ModuleId>
        {
            ["BD Pedidos"] = ModuleId.DbOrderChecker,
            ["BD Salud"]   = ModuleId.DbHealthChecker,
            ["Jobs"]       = ModuleId.JobsMonitor,
        };
        foreach (var d in domains)
        {
            if (d.Code == "M3") { ApplyApisWorstStatus(d); continue; }
            if (!map.TryGetValue(d.Label, out var moduleId)) continue;
            if (!LastCheckStore.Results.TryGetValue(moduleId, out var r)) continue;
            d.Color = r.Status switch
            {
                CheckStatus.Critical => "danger",
                CheckStatus.Warn     => "warning",
                _                    => "success"
            };
        }
        return domains;
    }

    private async Task RefreshBrandAsync(bool isManual = false)
    {
        bool hasData        = _brandSnapshots.Any() || _brandLiveCounts is not null;
        bool stateUnknown   = !hasData && !_brandDbUnavailable && !_brandStale;
        if (stateUnknown) { _brandLoading = true; StateHasChanged(); }
        else              { _brandRefreshing = true; }

        try
        {
            // Botón manual: consulta Salesforce en vivo, guarda snapshot y resetea el timer
            if (isManual)
            {
                _brandCountdown = (int)(BrandCheckerIntervalMinutes * 60);
                await BrandMonitorService.SimulateAndRefreshAsync();
            }

            var newSnapshots     = await BrandMonitorService.GetCurrentSnapshotsAsync();
            _brandSnapshots      = newSnapshots;
            _brandStale          = false;
            _brandDbUnavailable  = false;
            _brandLiveManual     = false;
            _brandLiveCounts     = null;
            _brandLastUpdate     = newSnapshots.Count > 0
                ? new DateTimeOffset(DateTime.SpecifyKind(newSnapshots.Max(s => s.CheckedAt), DateTimeKind.Utc))
                : DateTimeOffset.UtcNow;
        }
        catch (Exception ex)
        {
            _logger.LogWarning("Dashboard RefreshBrandAsync: BD no disponible — {Msg}", ex.Message);
            if (!hasData) _brandSnapshots = [];

            _brandStale         = _brandSnapshots.Any();
            _brandDbUnavailable = !_brandSnapshots.Any() && !(_brandLiveManual && _brandLiveCounts is not null);

            // Sin BD: mostrar datos en vivo de Salesforce
            if (isManual)
            {
                _brandLiveManual = true;
                _brandLiveCounts = await BrandMonitorService.GetLiveCountsAsync();
                if (_brandLiveCounts is not null)
                {
                    _brandDbUnavailable = false;
                    _brandStale         = false;
                    _brandLastUpdate    = DateTimeOffset.UtcNow;
                }
            }
        }
        finally
        {
            _brandLoading    = false;
            _brandRefreshing = false;
            StateHasChanged();
        }
    }

    private static string FormatElapsed(DateTimeOffset utc)
    {
        var elapsed = DateTimeOffset.UtcNow - utc;
        return elapsed.TotalSeconds < 60
            ? $"{(int)elapsed.TotalSeconds}s"
            : $"{(int)elapsed.TotalMinutes}m {(int)elapsed.Seconds}s";
    }

    private static string FormatElapsedAlt(DateTimeOffset utc)
    {
        var elapsed = DateTimeOffset.UtcNow - utc;
        return $"hace {(int)elapsed.TotalSeconds}s";
    }

    private static string FormatCountdown(int seconds)
    {
        return seconds < 60 ? $"{seconds}s" : $"{seconds / 60}m {seconds % 60}s";
    }

    private async Task ResolveAsync(Guid id)
    {
        if (_resolving.Contains(id)) return;
        _resolving.Add(id);
        try
        {
            await IncidentService.CloseManuallyAsync(id, _userRole, "Cerrado manualmente desde Dashboard");
            await RefreshIncidentsAsync();
        }
        catch { }
        finally
        {
            _resolving.Remove(id);
        }
    }

    private void UpdateDomainCard(Incident inc)
    {
        var label = inc.Module switch
        {
            ModuleId.DbOrderChecker  => "BD Pedidos",
            ModuleId.DbHealthChecker => "BD Salud",
            ModuleId.JobsMonitor     => "Jobs",
            ModuleId.SalesforceApi or ModuleId.MultivendeApi => "APIs Externas",
            _ => null
        };
        if (label is null) return;

        var card = _domains.FirstOrDefault(d => d.Label == label);
        if (card is null) return;

        if (SeverityColor(inc.Severity) == "danger" || card.Color != "danger")
        {
            card.Color = SeverityColor(inc.Severity);
        }

        if (inc.Module == ModuleId.DbOrderChecker && inc.Alert?.QuePaso is { } details)
        {
            card.Channels = ParseChannelDetails(details);
        }
    }

    private void ApplyLastCheckResult(DomainCard card)
    {
        if (card.Code == "M3")
        {
            ApplyApisWorstStatus(card);
            return;
        }
        var module = card.Label switch
        {
            "BD Pedidos" => (ModuleId?)ModuleId.DbOrderChecker,
            _            => null
        };
        if (module is null) return;
        if (LastCheckStore.Results.TryGetValue(module.Value, out var result))
            card.Channels = ParseChannelDetails(result.Details);
    }

    private void ApplyApisWorstStatus(DomainCard card)
    {
        bool hasSf = LastCheckStore.Results.TryGetValue(ModuleId.SalesforceApi, out var r1);
        bool hasMv = LastCheckStore.Results.TryGetValue(ModuleId.MultivendeApi, out var r2);

        // Ningún checker ha corrido aún (ventana de arranque ~30s)
        if (!hasSf && !hasMv)
        {
            card.Color      = "secondary";
            card.ApiDetails = [new("Salesforce", "Sin datos", "secondary"), new("Multivende", "Sin datos", "secondary")];
            return;
        }

        var sfStatus = hasSf ? r1!.Status : (CheckStatus?)null;
        var mvStatus = hasMv ? r2!.Status : (CheckStatus?)null;

        // Peor estado entre los que tienen datos — Critical supera Warn supera Ok
        string worstColor =
            (sfStatus == CheckStatus.Critical || mvStatus == CheckStatus.Critical) ? "danger"  :
            (sfStatus == CheckStatus.Warn     || mvStatus == CheckStatus.Warn)     ? "warning" :
            "success";

        // Escalate-only: no degradar un estado ya fijado por un incidente activo
        bool escalateOnly = card.Color is "danger" || (card.Color is "warning" && worstColor is "success");
        if (!escalateOnly)
            card.Color = worstColor;

        // Siempre poblar detalle por integración
        card.ApiDetails = [BuildApiItem("Salesforce", hasSf ? r1 : null), BuildApiItem("Multivende", hasMv ? r2 : null)];
    }

    private static ApiItem BuildApiItem(string name, CheckResult? result)
    {
        if (result is null)
            return new(name, "Sin datos", "secondary");
        return result.Status switch
        {
            CheckStatus.Ok       => new(name, "Disponible",       "success"),
            CheckStatus.Warn     => new(name, "Con advertencias", "warning", ParseCause(result.Details)),
            CheckStatus.Critical => ParseCritical(name, result.Details),
            _                    => new(name, "Sin datos",         "secondary"),
        };
    }

    private static ApiItem ParseCritical(string name, string? details)
    {
        if (string.IsNullOrWhiteSpace(details))
            return new(name, "Sin respuesta", "danger");

        // Quitar prefijo del nombre si el checker lo incluye: "Multivende HTTP 401 — ..."
        var text = details.StartsWith(name, StringComparison.OrdinalIgnoreCase)
            ? details[name.Length..].TrimStart()
            : details;

        // Separar "Tipo corto — causa real"
        var sep = text.IndexOf(" — ", StringComparison.Ordinal);
        if (sep > 0)
            return new(name, text[..sep].Trim(), "danger", Truncate(text[(sep + 3)..].Trim(), 32));

        return new(name, Truncate(text, 30), "danger");
    }

    private static string? ParseCause(string? details)
    {
        if (string.IsNullOrWhiteSpace(details)) return null;
        var sep = details.IndexOf(" — ", StringComparison.Ordinal);
        return sep > 0
            ? Truncate(details[(sep + 3)..].Trim(), 32)
            : Truncate(details, 32);
    }

    private static string Truncate(string text, int max) =>
        text.Length <= max ? text : text[..max].TrimEnd() + "…";

    // Lee conteos de LastCheckStore cuando BD no está disponible (checker escribe, UI solo lee)
    private IReadOnlyDictionary<string, int>? GetBrandCountsFromLastCheckStore()
    {
        if (!LastCheckStore.Results.TryGetValue(ModuleId.BrandMonitor, out var r)) return null;
        if (string.IsNullOrWhiteSpace(r.Details)) return null;
        var result = new Dictionary<string, int>();
        foreach (var part in r.Details.Split('|', StringSplitOptions.RemoveEmptyEntries))
        {
            var seg = part.Split(':');
            if (seg.Length >= 2 && int.TryParse(seg[1], out var count))
                result[seg[0]] = count;
        }
        return result.Count > 0 ? result : null;
    }

    private static string ApiStatusIcon(string color) => color switch
    {
        "success" => "✅",
        "warning" => "⚠",
        "danger"  => "❌",
        _         => "—",
    };

    private static string ApiStatusClass(string color) => color switch
    {
        "success" => "text-success",
        "warning" => "text-warning",
        "danger"  => "text-danger",
        _         => "text-muted",
    };

    private static List<ChannelItem>? ParseChannelDetails(string details)
    {
        var parts = details.Split('|', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return null;

        var items = new List<ChannelItem>();
        foreach (var part in parts)
        {
            var segments = part.Split(':');
            if (segments.Length >= 3 &&
                int.TryParse(segments[1], out var count))
            {
                items.Add(new ChannelItem(segments[0], count, segments[2] == "OK"));
            }
        }
        return items.Count > 0 ? items : null;
    }

    private void UpdateOverallStatus()
    {
        if (_openIncidents.Any(i => i.Severity == Severity.Critical))
        {
            _overallColor = "danger";
            _overallText  = "CRÍTICO";
        }
        else if (_openIncidents.Any(i => i.Severity == Severity.Warn))
        {
            _overallColor = "warning";
            _overallText  = "ADVERTENCIA";
        }
        else
        {
            _overallColor = "success";
            _overallText  = "OPERATIVO";
        }
    }

    private static string SeverityColor(Severity s) => s switch
    {
        Severity.Critical => "danger",
        Severity.Warn     => "warning",
        _                 => "success"
    };

    private static List<DomainCard> BuildDefaultDomains() =>
    [
        new("BD Pedidos",    "M2",  "success"),
        new("APIs Externas", "M3",  "success"),
        new("BD Salud",      "M4",  "success"),
        new("Jobs",          "M11", "success"),
    ];

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
        if (_alertHandler is not null) Broadcaster.OnAlert          -= _alertHandler;
        if (_closeHandler is not null) Broadcaster.OnIncidentClosed -= _closeHandler;
    }

    private sealed class DomainCard(string label, string code, string color)
    {
        public string             Label      { get; }      = label;
        public string             Code       { get; }      = code;
        public string             Color      { get; set; } = color;
        public List<ChannelItem>? Channels   { get; set; }
        public List<ApiItem>?     ApiDetails { get; set; }
    }

    private sealed record ChannelItem(string Name, int Count, bool IsOk);
    private sealed record ApiItem(string Name, string StatusLabel, string BadgeColor, string? Detail = null);
}

