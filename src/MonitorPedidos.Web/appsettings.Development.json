{
  "DetailedErrors": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.AspNetCore.SignalR": "Debug",
        "Microsoft.AspNetCore.Http.Connections": "Debug",
        "Microsoft.AspNetCore.Components": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/monitor-pedidos-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "MaxExportLines": 100,
    "FilePath": "logs/monitor-pedidos-.log"
  },
  "Incidents": {
    "RetentionDays": 7
  },
  "BrandMonitor": {
    "SnapshotRetentionHours": 2
  },
  "Monitoring": {
    "CheckerIntervalMinutes":       0.5,
    "ApiCheckerIntervalMinutes":    1,
    "OrderDetectionWindowMinutes":  30,
    "BrandMonitorWindowSeconds":   600,
    "BrandMonitorPollIntervalMinutes": 1
  },
  "Salesforce": {
    "OcapiHost": "",
    "OcapiSite": "",
    "ClientId": "",
    "ClientPassword": ""
  },
  "Multivende": {
    "BaseUrl": "https://api.multivende.com/apps/"
  },
  "Simulation": {
    "Enabled": false
  },
  "OrderSeed": {
    "Enabled": true,
    "OrdersPerChannel": 3
  },
  "OrderFeeder": {
    "Enabled": true,
    "BurstIntervalMinutes": 15,
    "OrdersPerChannel": 2,
    "RetentionHours": 1
  }
}
