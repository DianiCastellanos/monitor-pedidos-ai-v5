{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "ProductionDb": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/monitor-pedidos-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} | rid={RequestId}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Incidents": {
    "RetentionDays": 90
  },
  "BrandMonitor": {
    "SnapshotRetentionHours": 48
  },
  "Monitoring": {
    "CheckerIntervalMinutes":        5,
    "ApiCheckerIntervalMinutes":     5,
    "CheckerTimeoutMs":          30000,
    "OrderDetectionWindowMinutes":  30,
    "DbWarnLatencyMs":            1000,
    "DbCritTimeoutMs":            5000,
    "BrandMonitorWindowSeconds":        600,
    "BrandMonitorPollIntervalMinutes":    3
  },
  "Salesforce": {
    "Sites": [],
    "ClientId": "",
    "ClientPassword": "",
    "OAuthTokenUrl": "",
    "OAuthGrantType": "",
    "SearchWindowHours": 24,
    "CriticalThreshold": 50
  },
  "Multivende": {
    "BaseUrl": ""
  },
  "Logging": {
    "MaxExportLines": 500,
    "FilePath": "logs/monitor-pedidos-.log"
  },
  "JobsMonitor": {
    "Server": "SR-SDEV02CO.patprimo.local",
    "TaskName": "OC_PATPRIMO",
    "CommandTimeoutMs": 10000
  },
  "OrderSync": {
    "WindowDays": 30
  },
  "Simulation": {
    "Enabled": false
  },
  "OrderSeed": {
    "Enabled": true,
    "OrdersPerChannel": 3
  },
  "OrderFeeder": {
    "Enabled": false,
    "BurstIntervalMinutes": 15,
    "OrdersPerChannel": 2,
    "RetentionHours": 1
  },
  "AllowedHosts": "*"
}
